      "dark": "darkOrange",
      "light": "lightOrange"
    },
    "secondary": {
      "dark": "darkBlue",
      "light": "lightBlue"
    },
    "accent": {
      "dark": "darkCyan",
      "light": "lightCyan"
    },
    "error": {
      "dark": "darkRed",
      "light": "lightRed"
    },
    "warning": {
      "dark": "darkYellow",
