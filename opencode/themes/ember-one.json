    "darkGreen": "#99C45C",
    "darkCyan": "#36CDBB",
    "darkBlue": "#5FAAF7",
    "darkPurple": "#B96EF2",
    "darkMagenta": "#E655A7",
    "darkAddedBg": "#323E33",
    "darkRemovedBg": "#432C34",
    "darkAddedLineBg": "#41523B",
    "darkRemovedLineBg": "#5D343E",
    "lightBackground": "#F7F5F0",
