{
  "theme": "ember-one-fresh.json",
  "plugins": {
    "vi_mode": {
      "settings": {
        "autoStart": true,
        "arrowKeys": true,
        "searchWordUnderCursor": true
      },
      "enabled": true
    },
    "fresh-codespell": {
      "enabled": true,
      "settings": {
        "enabled": true,
        "cspellPath": "cspell",
        "nodePath": "node",
        "checkOnOpen": true,
        "checkOnSave": true,
        "checkAsYouType": true,
        "debounceMs": 650,
        "maxFileSizeKb": 1024,
        "debug": false
      }
    }
  },
  "version": 2,
  "lsp": {
    "markdown": {
      "enabled": true,
      "auto_start": true,
      "process_limits": {
        "max_memory_percent": 50,
        "max_cpu_percent": 90,
        "enabled": false
      }
    }
  }
}
